rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(hid) {
      return signedIn()
        && exists(/databases/$(database)/documents/households/$(hid))
        && get(/databases/$(database)/documents/households/$(hid)).data.members[request.auth.uid] == true;
    }
    match /profiles/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, delete: if false;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['householdId'])
        && request.resource.data.householdId is string
        && member(request.resource.data.householdId);
    }
    match /households/{hid} {
      allow get: if signedIn();
      allow list, delete: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid', 'members'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] == true;
      allow update: if signedIn()
        && resource.data.keys().hasOnly(['ownerUid', 'members'])
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] == true
        && !(request.auth.uid in resource.data.members);
      match /entries/{entryId} {
        allow read, delete: if member(hid);
        allow create: if member(hid)
          && request.resource.data.keys().hasOnly(['title','amount','type','owner','month','createdBy','createdAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 160
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.type in ['Ingreso','Gasto','Deuda']
          && request.resource.data.owner in ['Familiar','Yo','Esposa']
          && request.resource.data.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt is int;
        allow update: if member(hid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','amount'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 160
          && request.resource.data.amount is int
          && request.resource.data.amount > 0;
      }
      match /budgets/{month} {
        allow read: if member(hid);
        allow create, update: if member(hid)
          && month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && request.resource.data.keys().hasOnly(['amount','updatedBy'])
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if false;
      }
      match /debts/{debtId} {
        allow read: if member(hid);
        allow create: if member(hid)
          && request.resource.data.keys().hasOnly(['title','total','paid','installments','dueDate','owner','createdBy'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 160
          && request.resource.data.total is int
          && request.resource.data.total > 0
          && request.resource.data.paid is int
          && request.resource.data.paid >= 0
          && request.resource.data.paid <= request.resource.data.total
          && request.resource.data.installments is int
          && request.resource.data.installments > 0
          && request.resource.data.dueDate is string
          && request.resource.data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.owner in ['Familiar','Yo','Esposa']
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if member(hid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paid'])
          && request.resource.data.paid is int
          && request.resource.data.paid >= resource.data.paid
          && request.resource.data.paid <= resource.data.total;
        allow delete: if false;
      }
    }
  }
}
