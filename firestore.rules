rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(hid) {
      return signedIn() &&
        get(/databases/$(database)/documents/households/$(hid)).data.members[request.auth.uid] == true;
    }
    match /profiles/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['householdId'])
        && request.resource.data.householdId is string
        && exists(/databases/$(database)/documents/households/$(request.resource.data.householdId))
        && get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.members[uid] == true;
      allow delete: if false;
    }
    match /households/{hid} {
      // The household identifier is a random UUID shared privately as an invitation.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid', 'members'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] == true;
      allow update: if signedIn()
        && resource.data.keys().hasOnly(['ownerUid', 'members'])
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] == true
        && !(request.auth.uid in resource.data.members);
      allow delete: if false;
      match /entries/{entryId} {
        allow get, list: if member(hid);
        allow create: if member(hid)
          && request.resource.data.keys().hasOnly(['title','amount','type','owner','month','createdBy','createdAt'])
          && request.resource.data.title is string && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 160
          && request.resource.data.amount is int && request.resource.data.amount > 0
          && request.resource.data.type in ['Ingreso','Gasto','Deuda']
          && request.resource.data.owner in ['Familiar','Yo','Esposa']
          && request.resource.data.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt is int;
        allow delete: if member(hid);
        allow update: if member(hid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'amount'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 160
          && request.resource.data.amount is int
          && request.resource.data.amount > 0;
      }
    }
  }
}
